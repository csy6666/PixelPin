<Window x:Class="PixelPin.Windows.BeautifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 美化导出"
        Width="900"
        Height="660"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,18,20,16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="美化导出" />
      <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                 Text="给截图加上留白、圆角和阴影。预览与导出使用同一个渲染器，所见即所得。" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="取消美化" Style="{StaticResource GhostButtonStyle}"
                  ToolTip="移除已有的美化效果" Click="Remove_Click" />
          <Button Content="取消" Margin="4,0,0,0" IsCancel="True" Click="Cancel_Click" />
          <Button Content="应用" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                  IsDefault="True" Click="Apply_Click" />
        </StackPanel>
        <TextBlock x:Name="SizeText" Style="{StaticResource FieldHint}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="背景样式" />
            <ListBox x:Name="PresetList" Height="188" Margin="0,8,0,0"
                     SelectionChanged="PresetList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The swatch is the preset's own gradient, so the list shows
                         what the option looks like instead of describing it. -->
                    <Border Width="34" Height="24" CornerRadius="4" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            Background="{Binding PreviewBrush}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Name}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="留白" />
              <TextBlock x:Name="PaddingText" Grid.Column="1" Style="{StaticResource FieldHint}" />
            </Grid>
            <Slider x:Name="PaddingSlider" Minimum="0" Maximum="200" TickFrequency="4"
                    IsSnapToTickEnabled="True" ValueChanged="Option_Changed" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="圆角" />
              <TextBlock x:Name="RadiusText" Grid.Column="1" Style="{StaticResource FieldHint}" />
            </Grid>
            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="60" TickFrequency="2"
                    IsSnapToTickEnabled="True" ValueChanged="Option_Changed" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="阴影" />
              <TextBlock x:Name="ShadowText" Grid.Column="1" Style="{StaticResource FieldHint}" />
            </Grid>
            <Slider x:Name="ShadowSlider" Minimum="0" Maximum="60" TickFrequency="2"
                    IsSnapToTickEnabled="True" ValueChanged="Option_Changed" />

            <TextBlock Style="{StaticResource FieldHint}" Margin="0,14,0,0"
                       Text="留白过小时阴影会自动收窄，保证不会被裁掉。" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CanvasSurface}" ClipToBounds="True">
        <!-- No checkerboard here: the beautified preview is opaque, so a neutral
             backdrop is what makes its own gradient and shadow readable. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
          <Image x:Name="PreviewImage" Stretch="None" Margin="18" />
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
