<Window x:Class="PixelPin.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin Settings"
        Width="560"
        Height="590"
        MinWidth="500"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="22" FontWeight="SemiBold" Text="PixelPin" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,18" Foreground="DimGray"
                 Text="Screenshot, pin, and local-history preferences." />

      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Capture shortcut" />
      <TextBox x:Name="CaptureHotKeyBox" Grid.Row="2" Grid.Column="1" Padding="6" />

      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Mouse-through shortcut" />
      <TextBox x:Name="MouseThroughHotKeyBox" Grid.Row="3" Grid.Column="1" Padding="6" />

      <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Save folder" />
      <Grid Grid.Row="4" Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SaveDirectoryBox" Padding="6" />
        <Button Grid.Column="1" Content="Browse" Click="BrowseSaveFolder_Click" />
      </Grid>

      <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="File name template" />
      <TextBox x:Name="FileNameTemplateBox" Grid.Row="5" Grid.Column="1" Padding="6"
               ToolTip="Supported tokens: {yyyyMMdd_HHmmss}, {yyyy-MM-dd}, {HHmmss}" />

      <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Sticker opacity" />
      <Grid Grid.Row="6" Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="58" />
        </Grid.ColumnDefinitions>
        <Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1" SmallChange="0.05"
                ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center" />
        <TextBlock x:Name="OpacityValue" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="History entries" />
      <TextBox x:Name="HistoryLimitBox" Grid.Row="7" Grid.Column="1" Padding="6" />

      <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="History cache (MB)" />
      <TextBox x:Name="HistoryDiskLimitBox" Grid.Row="8" Grid.Column="1" Padding="6" />

      <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,18,0,0">
        <CheckBox x:Name="StartWithWindowsBox" Content="Start PixelPin with Windows" Margin="0,4" />
        <CheckBox x:Name="CopyAfterCaptureBox" Content="Copy every completed capture to the clipboard" Margin="0,4" />
        <CheckBox x:Name="PinAfterCaptureBox" Content="Pin every completed capture to the desktop" Margin="0,4" />
        <TextBlock x:Name="StatusText" Margin="0,14,0,0" Foreground="Firebrick" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" Foreground="DimGray" TextWrapping="Wrap"
                   Text="Settings export is explicit and local. OCR, scrolling capture, and WebP report a visible unavailable state until their Windows components and validation paths are ready." />
      </StackPanel>

      <WrapPanel Grid.Row="10" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Import..." ToolTip="Load a local PixelPin settings JSON file" Click="Import_Click" />
        <Button Content="Export..." ToolTip="Save these settings as a local JSON file" Click="Export_Click" />
        <Button Content="Privacy and diagnostics" ToolTip="View local storage and diagnostics" Click="Diagnostics_Click" />
        <Button Content="Cancel" Click="Cancel_Click" />
        <Button Content="Save settings" Background="{StaticResource AccentBrush}" Foreground="White" Click="Save_Click" />
      </WrapPanel>
    </Grid>
  </ScrollViewer>
</Window>
