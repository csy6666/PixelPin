<Window x:Class="PixelPin.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 设置"
        Width="660"
        Height="760"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Shortcut fields record the pressed combination instead of accepting typed
         text, so the user cannot mistype a key name. -->
    <Style x:Key="HotKeyBox" TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}">
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="False" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="ToolTip" Value="点击后直接按下组合键；Backspace 清除；Esc 撤销本次录制。" />
      <EventSetter Event="PreviewKeyDown" Handler="HotKeyBox_PreviewKeyDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="HotKeyBox_GotKeyboardFocus" />
    </Style>

    <Style x:Key="Row" TargetType="FrameworkElement">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
      <StackPanel Margin="20,18,16,20">

        <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"
                   Text="截图、贴图和本地历史记录偏好。所有数据只保存在本机，不会上传。" />

        <!-- ===================== Shortcuts ===================== -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="全局快捷键" />
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,12"
                       Text="点击输入框后直接按下想要的组合键即可录制。" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="区域截图" />
              <TextBox x:Name="CaptureHotKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                       Style="{StaticResource HotKeyBox}" />

              <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="截图并贴图" />
              <TextBox x:Name="CapturePinHotKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                       Style="{StaticResource HotKeyBox}"
                       ToolTip="快速模式：松开鼠标后立即贴出所选区域。点击后直接按下组合键。" />

              <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="全屏截图" />
              <TextBox x:Name="CaptureFullScreenHotKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                       Style="{StaticResource HotKeyBox}" />

              <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="粘贴为贴图" />
              <TextBox x:Name="PasteStickerHotKeyBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                       Style="{StaticResource HotKeyBox}" />

              <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="鼠标穿透" />
              <TextBox x:Name="MouseThroughHotKeyBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                       Style="{StaticResource HotKeyBox}" />

              <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="关闭所有贴图" />
              <TextBox x:Name="CloseAllHotKeyBox" Grid.Row="5" Grid.Column="1"
                       Style="{StaticResource HotKeyBox}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ===================== Capture and output ===================== -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="截图与输出" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="保存文件夹" />
              <TextBox x:Name="SaveDirectoryBox" Grid.Column="1" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="浏览" Click="BrowseSaveFolder_Click" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="文件名模板" />
              <TextBox x:Name="FileNameTemplateBox" Grid.Column="1"
                       ToolTip="支持的变量：{yyyyMMdd_HHmmss}、{yyyy-MM-dd}、{HHmmss}" />
            </Grid>
            <TextBlock Style="{StaticResource FieldHint}" Margin="150,4,0,0"
                       Text="可用变量：{yyyyMMdd_HHmmss}、{yyyy-MM-dd}、{HHmmss}" />
          </StackPanel>
        </Border>

        <!-- ===================== Sticker defaults ===================== -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="贴图默认值" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="贴图不透明度" />
              <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.15" Maximum="1"
                      SmallChange="0.05" ValueChanged="OpacitySlider_ValueChanged" />
              <TextBlock x:Name="OpacityValue" Grid.Column="2" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Style="{StaticResource FieldHint}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="标注默认颜色" />
              <Button Grid.Column="1" Content="选择颜色" Click="PickAnnotationColor_Click" />
              <Rectangle x:Name="AnnotationColorPreview" Grid.Column="2" Width="32" Height="24"
                         Margin="8,0,0,0" RadiusX="4" RadiusY="4"
                         Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1" />
              <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Margin="20,0,10,0"
                         Text="线宽" HorizontalAlignment="Left" />
              <Slider x:Name="StrokeWidthSlider" Grid.Column="4" Width="140" Minimum="1" Maximum="14"
                      TickFrequency="1" IsSnapToTickEnabled="True" />
            </Grid>

            <!-- Both limits share a row: they are the same kind of decision and a
                 separate row each made the page scroll further than necessary. -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="历史记录数量" />
              <TextBox x:Name="HistoryLimitBox" Grid.Column="1" />
              <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="20,0,0,0"
                         Text="历史缓存上限" />
              <TextBox x:Name="HistoryDiskLimitBox" Grid.Column="3" />
              <TextBlock Grid.Column="4" Style="{StaticResource FieldHint}" Margin="8,0,0,0"
                         VerticalAlignment="Center" Text="MB" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ===================== Appearance ===================== -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="主题" VerticalAlignment="Center" />
              <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                        SelectionChanged="ThemePicker_SelectionChanged">
                <ComboBoxItem Content="跟随系统" Tag="System" />
                <ComboBoxItem Content="浅色" Tag="Light" />
                <ComboBoxItem Content="深色" Tag="Dark" />
              </ComboBox>
            </Grid>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                       Text="选择深色后立即生效，不需要重启。跟随系统时会随 Windows 的“应用”主题切换。" />
          </StackPanel>
        </Border>

        <!-- ===================== Behaviour ===================== -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="行为" />

            <StackPanel Margin="0,8,0,0">
              <CheckBox x:Name="StartWithWindowsBox" Content="随 Windows 启动 PixelPin" />
              <CheckBox x:Name="CopyAfterCaptureBox" Content="每次截图完成后自动复制到剪贴板" />
              <CheckBox x:Name="PinAfterCaptureBox" Content="每次截图完成后自动贴到桌面" />
              <CheckBox x:Name="SnapToWindowEdgesBox" Content="框选时自动吸附到窗口边缘" />
              <CheckBox x:Name="HighlightWindowOnHoverBox" Content="鼠标悬停时高亮所在窗口（单击即可截取该窗口）" />
              <CheckBox x:Name="StickerKeepAspectBox" Content="贴图缩放时保持原始比例" />
              <CheckBox x:Name="StickerDoubleClickCloseBox" Content="双击贴图即可关闭" />
            </StackPanel>

            <!-- The notice only occupies space once a message is written into it. -->
            <Border x:Name="StatusPanel" Margin="0,10,0,0">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource NoticePanel}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                       Text="设置导入导出只在本机进行。OCR、滚动截图和 WebP 在组件与验证路径准备好之前会明确提示不可用。" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <!-- Action bar stays outside the scroller so saving never requires scrolling, and
         is declared after the form so the Tab order matches what the window looks
         like: keyboard users meet the fields before the actions. -->
    <Border Grid.Row="1"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="恢复默认" Style="{StaticResource GhostButtonStyle}"
                  ToolTip="把本页所有设置恢复为初始值" Click="ResetDefaults_Click" />
          <Button Content="导入" Style="{StaticResource GhostButtonStyle}" Margin="2,0,0,0"
                  ToolTip="加载本地 PixelPin 设置 JSON 文件" Click="Import_Click" />
          <Button Content="导出" Style="{StaticResource GhostButtonStyle}" Margin="2,0,0,0"
                  ToolTip="将设置保存为本地 JSON 文件" Click="Export_Click" />
          <Button Content="隐私与诊断" Style="{StaticResource GhostButtonStyle}" Margin="2,0,0,0"
                  ToolTip="查看本地存储和诊断信息" Click="Diagnostics_Click" />
          <Border Width="1" Height="20" Margin="10,0" VerticalAlignment="Center"
                  Background="{DynamicResource DividerBrush}" />
          <Button Content="取消" IsCancel="True" Click="Cancel_Click" />
          <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                  IsDefault="True" Click="Save_Click" />
        </StackPanel>
        <TextBlock Text="设置只保存在本机。" Style="{StaticResource FieldHint}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
