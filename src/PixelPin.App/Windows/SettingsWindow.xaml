<Window x:Class="PixelPin.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 设置"
        Width="560"
        Height="590"
        MinWidth="500"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="22" FontWeight="SemiBold" Text="PixelPin" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,18" Foreground="DimGray"
                 Text="截图、贴图和本地历史记录偏好设置。" />

      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="截图快捷键" />
      <TextBox x:Name="CaptureHotKeyBox" Grid.Row="2" Grid.Column="1" Padding="6" />

      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="鼠标穿透快捷键" />
      <TextBox x:Name="MouseThroughHotKeyBox" Grid.Row="3" Grid.Column="1" Padding="6" />

      <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="保存文件夹" />
      <Grid Grid.Row="4" Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SaveDirectoryBox" Padding="6" />
        <Button Grid.Column="1" Content="浏览" Click="BrowseSaveFolder_Click" />
      </Grid>

      <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="文件名模板" />
      <TextBox x:Name="FileNameTemplateBox" Grid.Row="5" Grid.Column="1" Padding="6"
               ToolTip="支持的变量：{yyyyMMdd_HHmmss}、{yyyy-MM-dd}、{HHmmss}" />

      <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="贴图不透明度" />
      <Grid Grid.Row="6" Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="58" />
        </Grid.ColumnDefinitions>
        <Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1" SmallChange="0.05"
                ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center" />
        <TextBlock x:Name="OpacityValue" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="历史记录数量" />
      <TextBox x:Name="HistoryLimitBox" Grid.Row="7" Grid.Column="1" Padding="6" />

      <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="历史缓存（MB）" />
      <TextBox x:Name="HistoryDiskLimitBox" Grid.Row="8" Grid.Column="1" Padding="6" />

      <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,18,0,0">
        <CheckBox x:Name="StartWithWindowsBox" Content="随 Windows 启动 PixelPin" Margin="0,4" />
        <CheckBox x:Name="CopyAfterCaptureBox" Content="每次截图完成后自动复制到剪贴板" Margin="0,4" />
        <CheckBox x:Name="PinAfterCaptureBox" Content="每次截图完成后自动贴到桌面" Margin="0,4" />
        <TextBlock x:Name="StatusText" Margin="0,14,0,0" Foreground="Firebrick" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" Foreground="DimGray" TextWrapping="Wrap"
                   Text="设置导入导出只在本机进行。OCR、滚动截图和 WebP 在组件与验证路径准备好之前会明确提示不可用。" />
      </StackPanel>

      <WrapPanel Grid.Row="10" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="导入..." ToolTip="加载本地 PixelPin 设置 JSON 文件" Click="Import_Click" />
        <Button Content="导出..." ToolTip="将设置保存为本地 JSON 文件" Click="Export_Click" />
        <Button Content="隐私与诊断" ToolTip="查看本地存储和诊断信息" Click="Diagnostics_Click" />
        <Button Content="取消" Click="Cancel_Click" />
        <Button Content="保存设置" Background="{StaticResource AccentBrush}" Foreground="White" Click="Save_Click" />
      </WrapPanel>
    </Grid>
  </ScrollViewer>
</Window>
