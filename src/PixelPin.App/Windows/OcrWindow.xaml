<Window x:Class="PixelPin.Windows.OcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 文字识别"
        Width="780"
        Height="600"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,18,20,16">

    <!-- ===================== Header ===================== -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource FieldLabel}" Text="识别语言" Margin="0,0,8,0" />
          <ComboBox x:Name="LanguagePicker" Width="200" SelectionChanged="LanguagePicker_SelectionChanged" />
          <Button Content="重新识别" Margin="8,0,0,0" Click="Recognize_Click" />
        </StackPanel>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="文字识别" />
          <TextBlock x:Name="StatusText" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" Text="正在识别..." />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <!-- ===================== Actions ===================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="复制为一行" ToolTip="去掉换行，适合粘贴到搜索框" Click="CopySingleLine_Click" />
          <Button Content="复制全部" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                  ToolTip="保留原有换行" Click="CopyAll_Click" />
          <Button Content="关闭" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <TextBlock x:Name="HintText" Style="{StaticResource FieldHint}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="识别结果可以直接编辑，修改后再复制。" />
      </DockPanel>
    </Border>

    <!-- ===================== Result ===================== -->
    <Border Style="{StaticResource Card}" Padding="2">
      <Grid>
        <TextBox x:Name="ResultBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="{DynamicResource UiFontFamily}"
                 FontSize="14"
                 Padding="12,10"
                 BorderThickness="0"
                 Background="Transparent"
                 IsReadOnly="True" />

        <!-- Recognition can legitimately return nothing (a photo, an icon, a blank
             region). Saying so beats an empty white card. The status is checked as
             well, because an empty box also means "still working", and claiming
             nothing was found before the recognizer has answered would be a lie. -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="False">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <!-- Later triggers win in WPF, so the "still working" case comes last
                     and overrides the visible state above. -->
                <DataTrigger Binding="{Binding Text, ElementName=ResultBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Text, ElementName=ResultBox}" Value="" />
                    <Condition Binding="{Binding Text, ElementName=StatusText}" Value="正在识别..." />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Path Data="{StaticResource IconTextScan}" Width="24" Height="24" Stretch="Uniform"
                Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2"
                HorizontalAlignment="Center" />
          <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="没有识别到文字" />
          <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource FieldHint}"
                     Text="换一种识别语言，或截取文字更清晰、更大的区域。" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</Window>
