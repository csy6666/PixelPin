<Window x:Class="PixelPin.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 历史记录"
        Width="920"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20,18,20,16">

    <!-- ===================== Header ===================== -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PageTitle}" Text="历史记录" />
      <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                 Text="截图默认只保存在本机。搜索、加标签或收藏后，随时重新复制、贴图或编辑。" />

      <Grid Margin="0,14,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid MaxWidth="420" HorizontalAlignment="Left">
          <TextBox x:Name="SearchBox" Padding="34,6,10,6"
                   Tag="搜索时间、标签或尺寸"
                   TextChanged="SearchBox_TextChanged" />
          <Path Data="{StaticResource IconSearch}" Width="15" Height="15"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                Stretch="Uniform" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </StackPanel>

    <!-- ===================== Actions ===================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource FieldLabel}" Text="标签" Margin="0,0,8,0" />
          <TextBox x:Name="TagsBox" Grid.Column="1" Tag="多个标签用英文逗号分隔"
                   ToolTip="多个标签用英文逗号分隔" />
          <Button Grid.Column="2" Content="设置标签" Margin="8,0,0,0" Click="SetTags_Click" />
          <TextBlock Grid.Column="3" Style="{StaticResource FieldHint}" Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Text="标签只写入本地索引，不会离开这台电脑。" />
        </Grid>

        <DockPanel>
          <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" />
          <StackPanel Orientation="Horizontal">
            <Button Content="收藏" ToolTip="标记或取消收藏" Click="Favorite_Click" />
            <Button Content="复制" ToolTip="复制原图到剪贴板" Click="Copy_Click" />
            <Button Content="贴图" ToolTip="把所选截图贴到桌面" Click="Pin_Click" />
            <Button Content="编辑" ToolTip="在标注编辑器中打开" Click="Edit_Click" />
            <Button Content="保存 PNG" ToolTip="另存为 PNG 文件" Click="Save_Click" />
            <Border Width="1" Height="20" Margin="8,0" VerticalAlignment="Center"
                    Background="{DynamicResource DividerBrush}" />
            <Button Content="删除" Style="{StaticResource GhostButtonStyle}"
                    ToolTip="从历史记录中删除所选截图" Click="Delete_Click" />
            <Button Content="清空历史" Style="{StaticResource GhostButtonStyle}"
                    ToolTip="删除历史记录中缓存的全部截图" Click="Clear_Click" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- ===================== List and preview ===================== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Width="56" Height="42" CornerRadius="4" ClipToBounds="True"
                      Background="{DynamicResource CheckeredBrush}"
                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
              </Border>

              <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <!-- Run elements do not inherit the item DataContext reliably inside a
                     DataTemplate, which left these lines blank. Binding the TextBlock
                     itself keeps the values on screen. -->
                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} × {1} 像素">
                      <Binding Path="PixelWidth" />
                      <Binding Path="PixelHeight" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <Border Margin="0,4,0,0" HorizontalAlignment="Left" CornerRadius="3"
                        Background="{DynamicResource AccentSubtleBrush}" Padding="5,1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tags}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Tags}" FontSize="11"
                             Foreground="{DynamicResource AccentTextBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="160" />
                </Border>
              </StackPanel>

              <Path Grid.Column="2" Data="{StaticResource IconStar}" Width="13" Height="13"
                    Stretch="Uniform" Fill="{DynamicResource StarBrush}"
                    VerticalAlignment="Top" Margin="0,2,2,0">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Border Background="{DynamicResource CheckeredBrush}" CornerRadius="8" Margin="1" />
          <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14" />

          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source, ElementName=PreviewImage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Path Data="{StaticResource IconSearch}" Width="22" Height="22" Stretch="Uniform"
                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2"
                  HorizontalAlignment="Center" />
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="从左侧选择一条记录查看预览" />
            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource FieldHint}"
                       Text="没有记录时，先截一张图。" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
