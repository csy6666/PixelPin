<Window x:Class="PixelPin.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin History"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Search local history" />
      <TextBox x:Name="SearchBox" Grid.Column="1" Padding="6" TextChanged="SearchBox_TextChanged" />
    </Grid>

    <ListBox x:Name="HistoryList" Grid.Row="1" Grid.Column="0" DisplayMemberPath="DisplayName"
             SelectionChanged="HistoryList_SelectionChanged" />
    <Border Grid.Row="1" Grid.Column="2" Background="#F4F6F8" BorderBrush="#D7DCE2" BorderThickness="1">
      <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
    </Border>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBox x:Name="TagsBox" Width="150" Padding="6" ToolTip="Comma-separated local tags" />
      <Button Content="Set tags" Click="SetTags_Click" />
      <Button Content="Favorite" Click="Favorite_Click" />
      <Button Content="Copy" Click="Copy_Click" />
      <Button Content="Pin" Click="Pin_Click" />
      <Button Content="Edit" Click="Edit_Click" />
      <Button Content="Save PNG" Click="Save_Click" />
      <Button Content="Delete" Click="Delete_Click" />
      <Button Content="Clear history" Click="Clear_Click" />
      <Button Content="Close" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
