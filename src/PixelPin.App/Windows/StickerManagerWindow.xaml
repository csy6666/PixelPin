<Window x:Class="PixelPin.Windows.StickerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 贴图管理"
        Width="840"
        Height="560"
        MinWidth="650"
        MinHeight="430"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock FontSize="19" FontWeight="SemiBold" Text="贴图管理" />
      <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                 Text="管理当前贴图、恢复鼠标输入，并按单张或分组关闭贴图。" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="分组" />
        <TextBox x:Name="GroupNameBox" Grid.Column="1" Padding="6" ToolTip="留空表示未分组" />
        <Button Grid.Column="2" Content="分配" ToolTip="将所选贴图分配到此分组" Click="AssignGroup_Click" />
        <Button Grid.Column="3" Content="关闭分组" ToolTip="关闭此分组中的所有贴图" Click="CloseGroup_Click" />
        <Button Grid.Column="4" Content="刷新" ToolTip="刷新当前贴图列表" Click="Refresh_Click" />
        <Button Grid.Column="5" Content="全部关闭" ToolTip="关闭所有当前贴图" Click="CloseAll_Click" />
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="置于最前" ToolTip="将所选贴图置于其他贴图之上" Click="BringForward_Click" />
        <Button Content="切换置顶" ToolTip="切换所选贴图是否保持在普通窗口之上" Click="ToggleTopLayer_Click" />
        <Button Content="切换输入" ToolTip="切换所选贴图的鼠标穿透" Click="ToggleInput_Click" />
        <Button Content="关闭所选" ToolTip="关闭所选贴图" Click="CloseSelected_Click" />
        <Button Content="关闭管理器" Click="Close_Click" />
      </StackPanel>
    </StackPanel>

    <ListBox x:Name="StickerList" SelectionChanged="StickerList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4">
            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
            <TextBlock Margin="0,2,0,0" Foreground="DimGray" Text="{Binding ManagerDescription}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
