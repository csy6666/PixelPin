<Window x:Class="PixelPin.Windows.StickerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 贴图管理"
        Width="860"
        Height="580"
        MinWidth="680"
        MinHeight="440"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20,18,20,16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="贴图管理" />
      <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                 Text="管理当前贴图、恢复鼠标输入，并按单张或分组关闭贴图。" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource FieldLabel}" Text="分组" Margin="0,0,8,0" />
          <TextBox x:Name="GroupNameBox" Grid.Column="1" Tag="留空表示未分组" ToolTip="留空表示未分组" />
          <Button Grid.Column="2" Content="分配" Margin="8,0,0,0"
                  ToolTip="将所选贴图分配到此分组" Click="AssignGroup_Click" />
          <Button Grid.Column="3" Content="关闭分组" Margin="4,0,0,0"
                  ToolTip="关闭此分组中的所有贴图" Click="CloseGroup_Click" />
          <Button Grid.Column="5" Content="刷新" ToolTip="刷新当前贴图列表" Click="Refresh_Click" />
          <Button Grid.Column="6" Content="全部关闭" Style="{StaticResource GhostButtonStyle}"
                  ToolTip="关闭所有当前贴图" Click="CloseAll_Click" />
        </Grid>

        <DockPanel>
          <Button DockPanel.Dock="Right" Content="关闭管理器" Click="Close_Click" />
          <StackPanel Orientation="Horizontal">
            <Button Content="置于最前" ToolTip="将所选贴图置于其他贴图之上" Click="BringForward_Click" />
            <Button Content="切换置顶" ToolTip="切换所选贴图是否保持在普通窗口之上" Click="ToggleTopLayer_Click" />
            <Button Content="切换输入" ToolTip="切换所选贴图的鼠标穿透" Click="ToggleInput_Click" />
            <Button Content="关闭所选" Style="{StaticResource GhostButtonStyle}"
                    ToolTip="关闭所选贴图" Click="CloseSelected_Click" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid>
      <ListBox x:Name="StickerList" SelectionChanged="StickerList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Width="34" Height="34" CornerRadius="6" VerticalAlignment="Center"
                      Background="{DynamicResource AccentSubtleBrush}">
                <Path Data="M2,2 L14,2 L14,10 L10,14 L2,14 Z" Width="15" Height="15"
                      Stretch="Uniform"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                           Text="{Binding ManagerDescription}" TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <Border Grid.Column="2" CornerRadius="3" Padding="7,2" VerticalAlignment="Center"
                      Background="{DynamicResource AppBackgroundBrush}">
                <TextBlock Text="{Binding GroupName}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="当前没有贴图。按 Ctrl+F3 或把图片拖到桌面即可创建。">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count, ElementName=StickerList}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </DockPanel>
</Window>
