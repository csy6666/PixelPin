<Window x:Class="PixelPin.Windows.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseWheel="Window_MouseWheel"
        AllowDrop="True">
  <Border x:Name="Frame" Background="White" BorderBrush="#C9D1DA" BorderThickness="1" CornerRadius="2"
          MouseEnter="Frame_MouseEnter" MouseLeave="Frame_MouseLeave" MouseLeftButtonDown="Frame_MouseLeftButtonDown"
          DragOver="Frame_DragOver" Drop="Frame_Drop">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="复制" Click="Copy_Click" />
        <MenuItem Header="保存 PNG" Click="Save_Click" />
        <MenuItem Header="保存 JPEG" Click="SaveJpeg_Click" />
        <MenuItem Header="旋转 90 度" Click="Rotate_Click" />
        <MenuItem Header="切换阴影" Click="Shadow_Click" />
        <MenuItem Header="切换置顶" Click="AlwaysOnTop_Click" />
        <MenuItem Header="切换鼠标穿透" Click="MouseThrough_Click" />
        <Separator />
        <MenuItem Header="关闭" Click="Close_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="Root">
      <Image x:Name="StickerImage" Stretch="Fill" RenderTransformOrigin="0.5,0.5" />
      <Border x:Name="Toolbar" VerticalAlignment="Top" Background="#E919212C" Padding="3" Visibility="Collapsed">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <Button Content="-" ToolTip="缩小" Click="ScaleDown_Click" />
            <Button Content="+" ToolTip="放大" Click="ScaleUp_Click" />
            <Button Content="R" ToolTip="旋转 90 度" Click="Rotate_Click" />
            <Button Content="B" ToolTip="切换边框阴影" Click="Shadow_Click" />
            <Button Content="T" ToolTip="切换置顶" Click="AlwaysOnTop_Click" />
            <Button Content="C" ToolTip="复制图片" Click="Copy_Click" />
            <Button Content="S" ToolTip="保存 PNG" Click="Save_Click" />
            <Button Content="J" ToolTip="保存 JPEG" Click="SaveJpeg_Click" />
            <Button Content="输入" ToolTip="切换鼠标穿透（使用全局快捷键恢复输入）" Click="MouseThrough_Click" />
            <Slider x:Name="OpacitySlider" Width="80" Minimum="0.15" Maximum="1" SmallChange="0.05" ValueChanged="OpacitySlider_ValueChanged" />
            <Button Content="X" ToolTip="关闭贴图" Click="Close_Click" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border x:Name="MouseThroughBadge" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Background="#D9A33A00" Padding="8,3" Margin="4" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock Foreground="White" Text="鼠标已穿透：使用全局快捷键恢复输入" />
      </Border>
    </Grid>
  </Border>
</Window>
