<Window x:Class="PixelPin.Windows.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin sticker"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseWheel="Window_MouseWheel"
        AllowDrop="True">
  <Border x:Name="Frame" Background="White" BorderBrush="#C9D1DA" BorderThickness="1" CornerRadius="2"
          MouseEnter="Frame_MouseEnter" MouseLeave="Frame_MouseLeave" MouseLeftButtonDown="Frame_MouseLeftButtonDown"
          DragOver="Frame_DragOver" Drop="Frame_Drop">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Copy" Click="Copy_Click" />
        <MenuItem Header="Save PNG" Click="Save_Click" />
        <MenuItem Header="Save JPEG" Click="SaveJpeg_Click" />
        <MenuItem Header="Rotate 90 degrees" Click="Rotate_Click" />
        <MenuItem Header="Toggle shadow" Click="Shadow_Click" />
        <MenuItem Header="Toggle always on top" Click="AlwaysOnTop_Click" />
        <MenuItem Header="Toggle mouse-through" Click="MouseThrough_Click" />
        <Separator />
        <MenuItem Header="Close" Click="Close_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="Root">
      <Image x:Name="StickerImage" Stretch="Fill" RenderTransformOrigin="0.5,0.5" />
      <Border x:Name="Toolbar" VerticalAlignment="Top" Background="#E919212C" Padding="3" Visibility="Collapsed">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <Button Content="-" ToolTip="Scale down" Click="ScaleDown_Click" />
            <Button Content="+" ToolTip="Scale up" Click="ScaleUp_Click" />
            <Button Content="R" ToolTip="Rotate 90 degrees" Click="Rotate_Click" />
            <Button Content="B" ToolTip="Toggle border shadow" Click="Shadow_Click" />
            <Button Content="T" ToolTip="Toggle always on top" Click="AlwaysOnTop_Click" />
            <Button Content="C" ToolTip="Copy image" Click="Copy_Click" />
            <Button Content="S" ToolTip="Save PNG" Click="Save_Click" />
            <Button Content="J" ToolTip="Save JPEG" Click="SaveJpeg_Click" />
            <Button Content="Input" ToolTip="Toggle mouse-through (global shortcut restores input)" Click="MouseThrough_Click" />
            <Slider x:Name="OpacitySlider" Width="80" Minimum="0.15" Maximum="1" SmallChange="0.05" ValueChanged="OpacitySlider_ValueChanged" />
            <Button Content="X" ToolTip="Close sticker" Click="Close_Click" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border x:Name="MouseThroughBadge" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Background="#D9A33A00" Padding="8,3" Margin="4" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock Foreground="White" Text="Mouse-through: use global shortcut to restore input" />
      </Border>
    </Grid>
  </Border>
</Window>
