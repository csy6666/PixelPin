<Window x:Class="PixelPin.Windows.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 标注编辑"
        Width="1180"
        Height="800"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <!-- Tool glyphs take their colour from the owning toggle, so the checked state
         (accent foreground) applies to the icon and the label together. -->
    <Style x:Key="ToolGlyph" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,0,0" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stroke"
              Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
    </Style>

    <Style x:Key="ToolLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Same glyph treatment for the plain buttons in the action rows. -->
    <Style x:Key="ActionGlyph" TargetType="Path" BasedOn="{StaticResource ToolGlyph}">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="ActionLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolButton" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggleStyle}">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="1,0" />
    </Style>

    <Style x:Key="PropertyLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="ToolbarRule" TargetType="Border" BasedOn="{StaticResource ToolGroupSeparator}" />
  </Window.Resources>

  <DockPanel>
    <!-- ============================ Toolbar ============================ -->
    <Border x:Name="Toolbar" DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel>

        <!-- Row 1: tool groups. A WrapPanel rather than a scroll strip, so a narrow
             window moves the last group to a second line instead of hiding it. -->
        <DockPanel Margin="10,8,10,0" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Undo_Click"
                    ToolTip="撤销（Ctrl+Z）">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconUndo}" />
                <TextBlock Style="{StaticResource ActionLabel}" Text="撤销" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Redo_Click"
                    ToolTip="重做（Ctrl+Y）">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconRedo}" />
                <TextBlock Style="{StaticResource ActionLabel}" Text="重做" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Clear_Click"
                    ToolTip="清除全部标注">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconTrash}" />
                <TextBlock Style="{StaticResource ActionLabel}" Text="清除" />
              </StackPanel>
            </Button>
          </StackPanel>

          <WrapPanel x:Name="ToolGroups" VerticalAlignment="Center">
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Select" ToolTip="只选择，不绘制"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconCursor}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="选择" />
              </StackPanel>
            </ToggleButton>
            <Border Style="{StaticResource ToolbarRule}" />
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Rectangle" ToolTip="矩形标注"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconRectangle}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="矩形" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Ellipse" ToolTip="椭圆标注"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconEllipse}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="椭圆" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Line" ToolTip="直线标注"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconLine}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="直线" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Arrow" ToolTip="箭头标注"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconArrow}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="箭头" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Pen" ToolTip="自由绘制"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconPen}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="画笔" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Highlight" ToolTip="半透明高亮块"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconHighlight}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="高亮" />
              </StackPanel>
            </ToggleButton>
            <Border Style="{StaticResource ToolbarRule}" />
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Mosaic"
                          ToolTip="像素化一块区域，用于遮盖敏感内容" Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconMosaic}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="马赛克" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Blur"
                          ToolTip="模糊一块区域，用于遮盖敏感内容" Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconBlur}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="模糊" />
              </StackPanel>
            </ToggleButton>
            <Border Style="{StaticResource ToolbarRule}" />
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Sequence"
                          ToolTip="点击放置递增编号标记" Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconSequence}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="序号" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolButton}" Tag="Text" ToolTip="点击后添加文字"
                          Click="ToolButton_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ToolGlyph}" Data="{StaticResource IconText}" />
                <TextBlock Style="{StaticResource ToolLabel}" Text="文字" />
              </StackPanel>
            </ToggleButton>
          </WrapPanel>
        </DockPanel>

        <!-- Row 2: stroke properties on the left, export actions on the right. -->
        <Border Background="{DynamicResource ToolbarRowBrush}" Margin="0,8,0,0"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="10,0">
          <DockPanel Margin="0,6,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource ToolbarButtonStyle}" Click="Copy_Click"
                      ToolTip="复制带标注的图片（Ctrl+C）">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconCopy}" />
                  <TextBlock Style="{StaticResource ActionLabel}" Text="复制" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ToolbarButtonStyle}" Click="Save_Click"
                      ToolTip="保存到设置中的文件夹（Ctrl+S）">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconSave}" />
                  <TextBlock Style="{StaticResource ActionLabel}" Text="保存" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ToolbarButtonStyle}" Content="另存为"
                      ToolTip="选择文件位置并保存（Ctrl+Shift+S）" Click="SaveAs_Click" />
              <Button Style="{StaticResource ToolbarButtonStyle}" Click="Pin_Click"
                      ToolTip="贴出带标注的图片（Ctrl+P）">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconPin}" />
                  <TextBlock Style="{StaticResource ActionLabel}" Text="贴图" />
                </StackPanel>
              </Button>
              <Button x:Name="BeautifyButton" Style="{StaticResource ToolbarToggleLook}" Content="美化"
                      ToolTip="加圆角、阴影和渐变背景，适合分享（Ctrl+B）" Click="Beautify_Click" />
              <Button Style="{StaticResource ToolbarButtonStyle}" Click="Ocr_Click"
                      ToolTip="识别图中的文字并复制（Ctrl+Shift+O）">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconTextScan}" />
                  <TextBlock Style="{StaticResource ActionLabel}" Text="OCR" />
                </StackPanel>
              </Button>
              <Border Style="{StaticResource ToolbarRule}" Height="20" />
              <Button Style="{StaticResource AccentButtonStyle}" Content="完成" MinWidth="72"
                      ToolTip="保存到本地历史并关闭（Ctrl+Enter）" Click="Done_Click" />
            </StackPanel>

            <WrapPanel VerticalAlignment="Center">
              <!-- The swatch is the picker's closed state: each ComboBoxItem carries
                   its own chip, so the control shows the colour it will draw with. -->
              <TextBlock Style="{StaticResource PropertyLabel}" Text="颜色" />
              <ComboBox x:Name="ColorPicker" Width="104" SelectedIndex="0"
                        SelectionChanged="ColorPicker_SelectionChanged">
                <ComboBoxItem Tag="#E53935">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#E53935"
                            BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="红色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#1677FF">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#1677FF"
                            BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="蓝色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#F59E0B">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#F59E0B"
                            BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="琥珀色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#22C55E">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#22C55E"
                            BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="绿色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#A855F7">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#A855F7"
                            BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="紫色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#111827">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#111827"
                            BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="黑色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="#FFFFFF">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#FFFFFF"
                            BorderBrush="#33000000" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Margin="7,0,0,0" Text="白色" VerticalAlignment="Center" />
                  </StackPanel>
                </ComboBoxItem>
              </ComboBox>
              <Button Style="{StaticResource ToolbarButtonStyle}" Content="自定义"
                      Margin="4,0,0,0" ToolTip="选择任意颜色" Click="CustomColor_Click" />
              <!-- The live stroke swatch, which also reflects colours picked in the
                   system dialog that match no preset. -->
              <Rectangle x:Name="ColorPreview" Width="22" Height="22" RadiusX="4" RadiusY="4"
                         Margin="8,0,12,0" Stroke="{DynamicResource ControlBorderBrush}"
                         StrokeThickness="1" Fill="#E53935" VerticalAlignment="Center" />

              <TextBlock Style="{StaticResource PropertyLabel}" Text="线宽" />
              <Slider x:Name="StrokeWidthSlider" Width="86" Minimum="1" Maximum="14" Value="3"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
              <TextBlock x:Name="StrokeWidthText" Width="20" Margin="6,0,14,0"
                         VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" Text="3" />

              <TextBlock Style="{StaticResource PropertyLabel}" Text="字号" />
              <ComboBox x:Name="FontSizePicker" Width="68" SelectedIndex="2"
                        SelectionChanged="FontSizePicker_SelectionChanged">
                <ComboBoxItem Content="12" />
                <ComboBoxItem Content="16" />
                <ComboBoxItem Content="20" />
                <ComboBoxItem Content="26" />
                <ComboBoxItem Content="34" />
                <ComboBoxItem Content="46" />
              </ComboBox>
            </WrapPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ============================ Status bar ============================ -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Named as commands, not as values: the live percentage is the floating
               capsule's job, and a "100%" button sitting next to a "100%" readout
               reads as two readouts that disagree the moment the zoom changes. -->
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="原始大小" ToolTip="按原始像素显示（100%）"
                  Click="ZoomActual_Click" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="适应窗口" ToolTip="缩放到适合窗口"
                  Click="ZoomFit_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ============================ Canvas ============================ -->
    <Grid Background="{DynamicResource CanvasBackgroundBrush}">
      <ScrollViewer x:Name="SurfaceScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="Transparent">
        <!-- No margin here: RenderImage measures and arranges this element directly,
             so any inset would shift the exported pixels. -->
        <Grid x:Name="EditorSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
              ClipToBounds="True">
          <Grid.LayoutTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
          </Grid.LayoutTransform>
          <!-- Nothing may sit under the image: RenderImage renders this element
               straight to the export, so a backing sheet or outline would end up
               baked into the saved PNG. -->
          <Image x:Name="BaseImage" Stretch="Fill" IsHitTestVisible="False" />
          <Canvas x:Name="DrawingCanvas" Background="Transparent"
                  MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                  MouseMove="DrawingCanvas_MouseMove"
                  MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp" />
        </Grid>
      </ScrollViewer>

      <!-- Floating zoom readout. The status bar keeps the two preset buttons; the
           capsule carries the live value plus the stepping controls. -->
      <Border Style="{StaticResource FloatingPill}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,20,20">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinHeight="28"
                  Click="ZoomOut_Click" ToolTip="缩小（Ctrl+-）">
            <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconMinus}" Width="12" Height="12" />
          </Button>
          <TextBlock x:Name="ZoomText" Width="48" Text="100%" TextAlignment="Center"
                     VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinHeight="28"
                  Click="ZoomIn_Click" ToolTip="放大（Ctrl++）">
            <Path Style="{StaticResource ActionGlyph}" Data="{StaticResource IconPlus}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
