<Window x:Class="PixelPin.Windows.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin Editor"
        Width="1120"
        Height="760"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#F4F6F8" BorderBrush="#D7DCE2" BorderThickness="0,0,0,1" Padding="8">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="Rect" Tag="Rectangle" ToolTip="Rectangle annotation" Click="ToolButton_Click" />
        <Button Content="Ellipse" Tag="Ellipse" ToolTip="Ellipse annotation" Click="ToolButton_Click" />
        <Button Content="Line" Tag="Line" ToolTip="Line annotation" Click="ToolButton_Click" />
        <Button Content="Arrow" Tag="Arrow" ToolTip="Arrow annotation" Click="ToolButton_Click" />
        <Button Content="Pen" Tag="Pen" ToolTip="Freehand pen" Click="ToolButton_Click" />
        <Button Content="Mosaic" Tag="Mosaic" ToolTip="Pixelate a region" Click="ToolButton_Click" />
        <Button Content="Text" Tag="Text" ToolTip="Click to add text" Click="ToolButton_Click" />
        <Separator Width="12" />
        <ComboBox x:Name="ColorPicker" Width="105" SelectedIndex="0" SelectionChanged="ColorPicker_SelectionChanged">
          <ComboBoxItem Tag="#E53935" Content="Red" />
          <ComboBoxItem Tag="#1677FF" Content="Blue" />
          <ComboBoxItem Tag="#F59E0B" Content="Amber" />
          <ComboBoxItem Tag="#111827" Content="Black" />
          <ComboBoxItem Tag="#FFFFFF" Content="White" />
        </ComboBox>
        <TextBlock Margin="10,0,2,0" VerticalAlignment="Center" Text="Width" />
        <Slider x:Name="StrokeWidthSlider" Width="90" Minimum="1" Maximum="14" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" />
        <Separator Width="12" />
        <Button Content="Undo" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click" />
        <Button Content="Redo" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click" />
        <Button Content="Clear" ToolTip="Clear annotations" Click="Clear_Click" />
        <Separator Width="12" />
        <Button Content="Copy" ToolTip="Copy annotated image" Click="Copy_Click" />
        <Button Content="Save PNG" ToolTip="Save annotated image" Click="Save_Click" />
        <Button Content="Pin" ToolTip="Pin annotated image" Click="Pin_Click" />
        <Button Content="OCR" ToolTip="Extract text when an OCR engine is available" Click="Ocr_Click" />
        <Button Content="Done" ToolTip="Store annotated image in local history" Click="Done_Click" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F4F6F8" BorderBrush="#D7DCE2" BorderThickness="0,1,0,0" Padding="8,5">
      <TextBlock x:Name="StatusText" Foreground="DimGray" />
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#3B4350">
      <Grid x:Name="EditorSurface" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
        <Image x:Name="BaseImage" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="DrawingCanvas" Background="Transparent"
                MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                MouseMove="DrawingCanvas_MouseMove"
                MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
