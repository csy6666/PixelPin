<Window x:Class="PixelPin.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin Privacy and Diagnostics"
        Width="760"
        Height="570"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Refresh" ToolTip="Refresh the diagnostic report" Click="Refresh_Click" />
      <Button Content="Copy report" ToolTip="Copy diagnostics to the clipboard" Click="Copy_Click" />
      <Button Content="Open local data" ToolTip="Open PixelPin's local data folder" Click="OpenData_Click" />
      <Button Content="Clear diagnostics" ToolTip="Clear local diagnostic log files" Click="ClearLog_Click" />
      <Button Content="Close" Click="Close_Click" />
    </StackPanel>

    <TabControl>
      <TabItem Header="Diagnostics">
        <TextBox x:Name="ReportBox" Margin="8" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" />
      </TabItem>
      <TabItem Header="Privacy">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="22">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Local by default" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="PixelPin does not upload screenshots, clipboard images, local history, annotation data, OCR text, settings, or diagnostics. The application does not include analytics or a cloud account." />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="What remains on this computer" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Settings, cached history PNGs, and diagnostic messages are stored under the local PixelPin data folder. You can clear history in the History window and clear diagnostic messages from this window." />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Explicit actions only" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Exporting an image or settings file writes only to the folder you choose. Importing settings never imports image history. Features that require unavailable Windows components return a visible unavailable state instead of sending data elsewhere." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
