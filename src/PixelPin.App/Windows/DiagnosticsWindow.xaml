<Window x:Class="PixelPin.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 隐私与诊断"
        Width="780"
        Height="600"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20,18,20,16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="隐私与诊断" />
      <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                 Text="本地存储位置、运行环境与最近的诊断消息。这些内容不会上传。" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" />
        <StackPanel Orientation="Horizontal">
          <Button Content="刷新" ToolTip="刷新诊断报告" Click="Refresh_Click" />
          <Button Content="复制报告" ToolTip="复制诊断信息到剪贴板" Click="Copy_Click" />
          <Button Content="打开本地数据" ToolTip="打开 PixelPin 本地数据文件夹" Click="OpenData_Click" />
          <Button Content="清除诊断" Style="{StaticResource GhostButtonStyle}"
                  ToolTip="清除本地诊断日志文件" Click="ClearLog_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl>
      <TabItem Header="诊断信息">
        <Border Style="{StaticResource Card}" Padding="2" Margin="0,12,0,0">
          <TextBox x:Name="ReportBox" Margin="4" IsReadOnly="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                   BorderThickness="0" Background="Transparent" />
        </Border>
      </TabItem>

      <TabItem Header="隐私">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel MaxWidth="620" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="默认本地处理" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="PixelPin 不会上传截图、剪贴板图片、本地历史、标注数据、OCR 文本、设置或诊断信息。应用不包含分析服务，也不需要云端账号。" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="哪些内容会留在本机" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="设置、历史缓存 PNG 和诊断消息会保存在本地 PixelPin 数据文件夹中。你可以在历史记录窗口清除历史，也可以在此窗口清除诊断消息。" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="只在明确操作时写入" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="导出图片或设置文件时，只会写入你选择的文件夹。导入设置不会导入图片历史。依赖当前 Windows 组件的功能若不可用，会明确提示，不会向其他位置发送数据。" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
