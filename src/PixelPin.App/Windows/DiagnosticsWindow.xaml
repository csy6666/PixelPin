<Window x:Class="PixelPin.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPin 隐私与诊断"
        Width="760"
        Height="570"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="刷新" ToolTip="刷新诊断报告" Click="Refresh_Click" />
      <Button Content="复制报告" ToolTip="复制诊断信息到剪贴板" Click="Copy_Click" />
      <Button Content="打开本地数据" ToolTip="打开 PixelPin 本地数据文件夹" Click="OpenData_Click" />
      <Button Content="清除诊断" ToolTip="清除本地诊断日志文件" Click="ClearLog_Click" />
      <Button Content="关闭" Click="Close_Click" />
    </StackPanel>

    <TabControl>
      <TabItem Header="诊断信息">
        <TextBox x:Name="ReportBox" Margin="8" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" />
      </TabItem>
      <TabItem Header="隐私">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="22">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="默认本地处理" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="PixelPin 不会上传截图、剪贴板图片、本地历史、标注数据、OCR 文本、设置或诊断信息。应用不包含分析服务，也不需要云端账号。" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="哪些内容会留在本机" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="设置、历史缓存 PNG 和诊断消息会保存在本地 PixelPin 数据文件夹中。你可以在历史记录窗口清除历史，也可以在此窗口清除诊断消息。" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="只在明确操作时写入" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="导出图片或设置文件时，只会写入你选择的文件夹。导入设置不会导入图片历史。依赖当前 Windows 组件的功能若不可用，会明确提示，不会向其他位置发送数据。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
