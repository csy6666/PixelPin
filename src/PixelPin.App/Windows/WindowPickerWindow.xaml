<Window x:Class="PixelPin.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture a window"
        Width="760"
        Height="500"
        MinWidth="580"
        MinHeight="380"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Choose an application window" />
      <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                 Text="The list excludes PixelPin itself. This capture path records visible desktop content, so keep the target unobscured." />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Refresh" ToolTip="Refresh the list of capturable windows" Click="Refresh_Click" />
      <Button Content="Capture" Background="{StaticResource AccentBrush}" Foreground="White" Click="Capture_Click" />
      <Button Content="Cancel" Click="Cancel_Click" />
    </StackPanel>
    <ListBox x:Name="WindowList" DisplayMemberPath="DisplayName" MouseDoubleClick="WindowList_MouseDoubleClick" />
  </DockPanel>
</Window>
