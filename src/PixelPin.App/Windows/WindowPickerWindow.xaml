<Window x:Class="PixelPin.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口截图"
        Width="780"
        Height="540"
        MinWidth="580"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20,18,20,16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="选择应用程序窗口" />
      <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                 Text="列表不包含 PixelPin 自身。此方式截取可见桌面内容，请确保目标窗口没有被其他窗口遮挡。" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource FooterBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0"
            Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="刷新" ToolTip="刷新可截图窗口列表" Click="Refresh_Click" />
          <Button Content="截图" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                  Click="Capture_Click" />
          <Button Content="取消" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
        <TextBlock Style="{StaticResource FieldHint}" VerticalAlignment="Center"
                   Text="双击列表项也可以直接截图。" />
      </DockPanel>
    </Border>

    <Grid>
      <ListBox x:Name="WindowList" MouseDoubleClick="WindowList_MouseDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                           Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                         Foreground="{DynamicResource TextTertiaryBrush}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} × {1}">
                    <Binding Path="Bounds.Width" />
                    <Binding Path="Bounds.Height" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- An empty list is a normal state here (everything minimised, or the filter
           hides all windows), so it explains itself instead of showing a blank card. -->
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsHitTestVisible="False">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasItems, ElementName=WindowList}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Path Data="{StaticResource IconWindow}" Width="24" Height="24" Stretch="Uniform"
              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2"
              HorizontalAlignment="Center" />
        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="没有找到可截图的窗口" />
        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource FieldHint}"
                   Text="请先把目标窗口还原到桌面，然后点刷新。" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
