<Window x:Class="PixelPin.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口截图"
        Width="760"
        Height="500"
        MinWidth="580"
        MinHeight="380"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="选择应用程序窗口" />
      <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                 Text="列表不包含 PixelPin 自身。此方式截取可见桌面内容，请确保目标窗口没有被其他窗口遮挡。" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="刷新" ToolTip="刷新可截图窗口列表" Click="Refresh_Click" />
      <Button Content="截图" Background="{StaticResource AccentBrush}" Foreground="White" Click="Capture_Click" />
      <Button Content="取消" Click="Cancel_Click" />
    </StackPanel>
    <ListBox x:Name="WindowList" DisplayMemberPath="DisplayName" MouseDoubleClick="WindowList_MouseDoubleClick" />
  </DockPanel>
</Window>
