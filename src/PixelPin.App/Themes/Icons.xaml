<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Vector icons drawn on a 16x16 grid. Geometry beats an icon font here: Segoe
    MDL2 (Windows 10) and Segoe Fluent Icons (Windows 11) do not share every
    codepoint, and a missing glyph would render as a box. These paths are stroke
    friendly: use them on a Path with Stroke set and Fill left unset, except the
    star, which is meant to be filled.
  -->

  <GeometryGroup x:Key="IconSearch">
    <EllipseGeometry Center="6.6,6.6" RadiusX="5" RadiusY="5" />
    <LineGeometry StartPoint="10.3,10.3" EndPoint="14.2,14.2" />
  </GeometryGroup>

  <PathGeometry x:Key="IconChevronDown" Figures="M1,3.2 L5,7.2 L9,3.2" />
  <PathGeometry x:Key="IconCheck" Figures="M2,7.4 L5.6,11 L12.4,3.2" />
  <PathGeometry x:Key="IconClose" Figures="M4,4 L12,12 M12,4 L4,12" />
  <PathGeometry x:Key="IconPlus" Figures="M8,3 L8,13 M3,8 L13,8" />
  <PathGeometry x:Key="IconMinus" Figures="M3,8 L13,8" />
  <PathGeometry x:Key="IconFolder" Figures="M1.5,4.2 L6,4.2 L7.5,6.2 L14.5,6.2 L14.5,12.6 L1.5,12.6 Z" />
  <PathGeometry x:Key="IconTrash" Figures="M3,4.6 L13,4.6 M6,4.6 L6,2.4 L10,2.4 L10,4.6 M4.7,4.6 L5.4,13.6 L10.6,13.6 L11.3,4.6" />
  <PathGeometry x:Key="IconCopy" Figures="M5.6,5.6 L13.4,5.6 L13.4,13.4 L5.6,13.4 Z M2.6,10.4 L2.6,2.6 L10.4,2.6" />
  <PathGeometry x:Key="IconSave" Figures="M2.6,2.6 L11.4,2.6 L13.4,4.6 L13.4,13.4 L2.6,13.4 Z M5.2,2.6 L5.2,6.4 L10.4,6.4 L10.4,2.6 M5.2,13.4 L5.2,9.4 L10.8,9.4 L10.8,13.4" />
  <PathGeometry x:Key="IconStar" Figures="M8,1.4 L9.85,5.9 L14.7,6.3 L11,9.5 L12.15,14.3 L8,11.75 L3.85,14.3 L5,9.5 L1.3,6.3 L6.15,5.9 Z" />

  <!-- Editor tools. Each is an outline, so the same geometry works on a light
       toolbar and on the dark capture bar without a second set. -->
  <PathGeometry x:Key="IconCursor" Figures="M3.8,2.2 L3.8,12.9 L6.5,10.3 L8.2,14 L9.8,13.3 L8.1,9.7 L11.9,9.3 Z" />
  <PathGeometry x:Key="IconRectangle" Figures="M2.6,3.6 H13.4 V12.4 H2.6 Z" />
  <GeometryGroup x:Key="IconEllipse">
    <EllipseGeometry Center="8,8" RadiusX="5.6" RadiusY="4.6" />
  </GeometryGroup>
  <PathGeometry x:Key="IconLine" Figures="M2.8,13.2 L13.2,2.8" />
  <PathGeometry x:Key="IconArrow" Figures="M2.8,13.2 L13.2,2.8 M13.2,2.8 L13.2,7.6 M13.2,2.8 L8.4,2.8" />
  <PathGeometry x:Key="IconPen" Figures="M11.9,2.3 L13.7,4.1 L5.4,12.4 L2.6,13.4 L3.6,10.6 Z M10.6,3.6 L12.4,5.4" />
  <PathGeometry x:Key="IconHighlight" Figures="M9.4,2.4 L13.6,6.6 L8.4,11.8 L4.2,7.6 Z M2.6,13.4 H10.6 M6.6,5.2 L10.8,9.4" />
  <PathGeometry x:Key="IconMosaic" Figures="M2.6,2.6 H7.4 V7.4 H2.6 Z M8.6,2.6 H13.4 V7.4 H8.6 Z M2.6,8.6 H7.4 V13.4 H2.6 Z M8.6,8.6 H13.4 V13.4 H8.6 Z" />
  <GeometryGroup x:Key="IconBlur">
    <EllipseGeometry Center="8,8" RadiusX="5.6" RadiusY="5.6" />
    <EllipseGeometry Center="8,8" RadiusX="2.2" RadiusY="2.2" />
  </GeometryGroup>
  <PathGeometry x:Key="IconSequence" Figures="M8,2.4 A5.6,5.6 0 1 1 7.99,2.4 Z M6.5,6.3 L8.1,5.3 L8.1,10.9" />
  <PathGeometry x:Key="IconText" Figures="M2.8,3.6 H13.2 M8,3.6 V12.8 M5.8,12.8 H10.2" />

  <!-- History and zoom. -->
  <PathGeometry x:Key="IconUndo" Figures="M6.4,3.6 L2.6,7.4 L6.4,11.2 M2.6,7.4 H9.6 A3.4,3.4 0 0 1 9.6,14.2 H6.4" />
  <PathGeometry x:Key="IconRedo" Figures="M9.6,3.6 L13.4,7.4 L9.6,11.2 M13.4,7.4 H6.4 A3.4,3.4 0 0 0 6.4,14.2 H9.6" />
  <PathGeometry x:Key="IconZoomFit" Figures="M2.6,5.6 V2.6 H5.6 M10.4,2.6 H13.4 V5.6 M13.4,10.4 V13.4 H10.4 M5.6,13.4 H2.6 V10.4" />

  <!-- Capture bar and actions. -->
  <PathGeometry x:Key="IconPin" Figures="M6.2,2.6 H9.8 L9.1,6.3 L11.6,8.8 H4.4 L6.9,6.3 Z M8,8.8 V13.6" />
  <PathGeometry x:Key="IconBeautify" Figures="M8,1.8 L9.4,6.6 L14.2,8 L9.4,9.4 L8,14.2 L6.6,9.4 L1.8,8 L6.6,6.6 Z" />
  <PathGeometry x:Key="IconTextScan" Figures="M2.6,5.4 V2.6 H5.4 M10.6,2.6 H13.4 V5.4 M13.4,10.6 V13.4 H10.6 M5.4,13.4 H2.6 V10.6 M5.4,8 H10.6" />
  <PathGeometry x:Key="IconWindow" Figures="M2.6,3.6 H13.4 V12.4 H2.6 Z M2.6,6.4 H13.4 M5,5 L5,5.01" />
  <PathGeometry x:Key="IconScreen" Figures="M2.6,3.6 H13.4 V10.4 H2.6 Z M5.4,13.4 H10.6 M8,10.4 V13.4" />
  <PathGeometry x:Key="IconScroll" Figures="M8,2.4 V13.6 M4.8,5.6 L8,2.4 L11.2,5.6 M4.8,10.4 L8,13.6 L11.2,10.4" />
  <PathGeometry x:Key="IconTimer" Figures="M8,3.4 A5.2,5.2 0 1 1 7.99,3.4 Z M8,6.2 V8.4 L9.8,9.6 M6.4,1.6 H9.6" />
  <PathGeometry x:Key="IconCamera" Figures="M2.6,5.6 H5 L6.2,3.8 H9.8 L11,5.6 H13.4 V12.6 H2.6 Z M8,7 A2.2,2.2 0 1 1 7.99,7 Z" />

</ResourceDictionary>
