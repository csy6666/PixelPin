<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Light theme tokens. Every colour used by the application UI must be declared
    here rather than written inline in a window, so a dark dictionary can later
    replace this file without touching a single control template.

    Naming: <role>Brush. Values follow the Windows 11 neutral scale so the tool
    reads as part of the desktop instead of a web page.
  -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#EBEBEB" />
  <!-- Hover and pressed are drawn as a translucent overlay on top of whatever fill
       the button already has, so one template works for neutral and tinted buttons.
       The overlay is black on light surfaces and white on dark ones, which is the
       only difference between the two dictionaries here. -->
  <SolidColorBrush x:Key="HoverOverlayBrush" Color="#000000" />
  <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToolbarRowBrush" Color="#FAFAFA" />
  <!-- Tooltips are their own surface: they float over anything, so they need a
       solid fill rather than the page colour showing through. -->
  <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="TooltipBorderBrush" Color="#E1E1E1" />

  <!-- Lines -->
  <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="TrackBrush" Color="#D9D9D9" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C4C4" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A6A6A6" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161" />
  <!-- Tertiary is the hint colour, so it is the token most likely to drift too light.
       #767676 is the darkest grey that still reads as "quiet" while clearing 4.5:1
       against both the page (#F3F3F3) and a card (#FFFFFF). -->
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B6B6B" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSelectionBrush" Color="#401677FF" />

  <!-- Accent and state. The button fill is darker than the brand blue so white
       label text clears 4.5:1; #1677FF stays the hover/link accent. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#0B62D6" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1677FF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0850B4" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E8F1FF" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#A8CBFF" />
  <!-- Accent used as text on a subtle accent surface (the armed tool, a menu tick).
       It is a separate token from AccentPressedBrush because a button fill and a
       label colour have opposite contrast requirements. -->
  <SolidColorBrush x:Key="AccentTextBrush" Color="#0850B4" />
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEA" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F5E9" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
  <SolidColorBrush x:Key="FocusBrush" Color="#1677FF" />
  <SolidColorBrush x:Key="StarBrush" Color="#E8A33D" />

  <!-- Legacy key kept so older windows keep resolving while they are restyled. -->
  <SolidColorBrush x:Key="PanelBrush" Color="#F7F9FC" />

  <!-- Transparency checkerboard for image previews. -->
  <DrawingBrush x:Key="CheckeredBrush" TileMode="Tile"
                Viewport="0,0,16,16" ViewportUnits="Absolute"
                Viewbox="0,0,16,16" ViewboxUnits="Absolute" Stretch="Fill">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="#ECECEC" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Typography -->
  <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
