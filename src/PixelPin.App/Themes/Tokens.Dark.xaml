<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dark theme tokens. This dictionary must declare exactly the same keys as
    Tokens.Light.xaml: the control templates only ever look up keys, and a missing
    key would surface as an invisible control rather than a build error. The
    contrast pairs are asserted by the render harness for both dictionaries.

    Values follow the Windows 11 dark neutral scale (#202020 page, #2B2B2B card)
    so the tool matches File Explorer in dark mode.
  -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#323232" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#454545" />
  <!-- On a dark surface a hover has to lighten, so the overlay flips to white. -->
  <SolidColorBrush x:Key="HoverOverlayBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#272727" />
  <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#272727" />
  <!-- The canvas stays near black in both themes: it frames screenshots, and a
       light canvas would wash out the very content it is meant to isolate. -->
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#141414" />
  <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#272727" />
  <SolidColorBrush x:Key="ToolbarRowBrush" Color="#232323" />
  <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="TooltipBorderBrush" Color="#3F3F3F" />

  <!-- Lines -->
  <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="TrackBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5A" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#757575" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C2C2C2" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9B9B" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSelectionBrush" Color="#404096FF" />

  <!-- Accent and state. On a dark surface the accent has to be lighter to keep
       white label text readable, so it is the #4096FF step of the same ramp. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#2A6FD4" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C97F0" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E63C4" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3450" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#2F5C8F" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#9CC7FF" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F07A69" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A211E" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#5CC46A" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1E3320" />
  <SolidColorBrush x:Key="WarningBrush" Color="#E0A94B" />
  <SolidColorBrush x:Key="FocusBrush" Color="#7AB4FF" />
  <SolidColorBrush x:Key="StarBrush" Color="#E8A33D" />

  <!-- Legacy key kept so older windows keep resolving while they are restyled. -->
  <SolidColorBrush x:Key="PanelBrush" Color="#262626" />

  <!-- Transparency checkerboard for image previews. -->
  <DrawingBrush x:Key="CheckeredBrush" TileMode="Tile"
                Viewport="0,0,16,16" ViewportUnits="Absolute"
                Viewbox="0,0,16,16" ViewboxUnits="Absolute" Stretch="Fill">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#3A3A3A" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="#2E2E2E" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Typography is identical in both themes; it is declared here as well so the
       dark dictionary can be used on its own without a second merge. -->
  <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
