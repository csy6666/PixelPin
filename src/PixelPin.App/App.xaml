<Application x:Class="PixelPin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Order matters: tokens first, then the controls that consume them.
             Swapping Tokens.Light.xaml for a dark dictionary is all a future
             theme switch needs. -->
        <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Qualified with the assembly name so the icon resolves from any entry assembly,
           including the desktop probe that hosts these resources for testing. -->
      <BitmapImage x:Key="PixelPinIcon" UriSource="pack://application:,,,/PixelPin;component/Assets/PixelPin.png" />

      <!-- Application-wide typography. Foreground and font inherit down the visual
           tree, so every window picks up the same text colour without a per-window
           TextBlock style (which would also restyle text drawn on the canvas). -->
      <Style TargetType="Window">
        <Setter Property="Icon" Value="{StaticResource PixelPinIcon}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
